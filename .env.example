# ==========================================
# EventChain Environment Variables
# ==========================================

# ==========================================
# Database
# ==========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/eventchain"

# ==========================================
# NextAuth
# ==========================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key"

# ==========================================
# OAuth Providers
# ==========================================
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ==========================================
# Supabase (Storage)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ==========================================
# Blockchain / Web3
# ==========================================
# QR Code Signing Secret (used to sign QR codes)
QR_SIGNING_SECRET="your-qr-signing-secret"

# Blockchain RPC URL (Base Sepolia)
NEXT_PUBLIC_RPC_URL="https://sepolia.base.org"

# Chain ID for Base Sepolia
NEXT_PUBLIC_CHAIN_ID="84532"

# POAP Contract Address (deployed on Base Sepolia)
NEXT_PUBLIC_POAP_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"

# ==========================================
# Phase 5 — Treasury & Crypto Payments
# ==========================================

# Supported Networks (JSON array)
NEXT_PUBLIC_NETWORKS='[
  {
    "id": "baseSepolia",
    "name": "Base Sepolia",
    "chainId": 84532,
    "rpcUrl": "https://sepolia.base.org",
    "symbol": "ETH",
    "blockExplorer": "https://sepolia.basescan.org"
  },
  {
    "id": "robinhood",
    "name": "Robinhood Testnet",
    "chainId": 46630,
    "rpcUrl": "https://rpc.testnet.chain.robinhood.com",
    "symbol": "ETH",
    "blockExplorer": "https://explorer.testnet.chain.robinhood.com"
  }
]'

# Default network for payments
NEXT_PUBLIC_DEFAULT_NETWORK="baseSepolia"

# ==========================================
# Email (Resend / SendGrid)
# ==========================================
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@eventchain.xyz"

# ==========================================
# Telegram Bot
# ==========================================
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# ==========================================
# Redis (Rate Limiting - Optional)
# ==========================================
# UPSTASH_REDIS_REST_URL="https://your-redis-url"
# UPSTASH_REDIS_REST_TOKEN="your-redis-token"
